{#
/**
 * @file
 * Default theme implementation for Omnipedia site header.
 *
 * Available variables:
 *
 * - 'base_class': The base BEM class applied to the container and used to
 *   derive child and modifier classes from.
 *
 * - 'current_date': The current date content.
 *
 * - 'menu_link': In-page link to the menu block.
 *
 * @ingroup themeable
 */
#}

{# Current date BEM class. #}
{% set current_date = current_date|merge({
  '#attributes': current_date['#attributes'].addClass([
    base_class ~ '__current-date',
  ])
}) %}

{# Menu link BEM class and array conversion.

  We have to convert the attributes object into an array because
  \Drupal\Core\Render\Element\Link::preRenderLink() merges this using the '+'
  operator, leading to a fatal error if this is an Attributes object.
#}
{% set menu_link = menu_link|merge({
  '#attributes': menu_link['#attributes'].addClass([
    base_class ~ '__menu-link',
  ]).toArray(),
}) %}

<div{{ attributes.addClass([base_class]) }}>

  {{ current_date }}

  <div{{ menu_link['#wrapper_attributes'].addClass([base_class ~ '__menu']) }}>
    {{ menu_link }}
  </div>

</div>
